# .env.example - Placeholder configuration
# NEVER put real secrets, tokens, or passwords in this file or any Git-tracked file.

# Zerodha Kite Connect API (Entered once on-device in release; never embedded in APK)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Kotak Neo Trade API (Entered on-device; never embedded in APK)
KOTAK_CONSUMER_KEY=your_kotak_consumer_key_here
KOTAK_CONSUMER_SECRET=your_kotak_consumer_secret_here
KOTAK_MOBILE_NUMBER=+910000000000
KOTAK_UCC=your_kotak_ucc_here
